{
  "name": "stellarsecurity/support-client-laravel",
  "description": "Laravel HTTP client for Stellar Security Support Ticket API",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "illuminate/support": "^11.0|^12.0",
    "illuminate/http": "^11.0|^12.0",
    "guzzlehttp/guzzle": "^7.0"
  },
  "autoload": {
    "psr-4": {
      "StellarSecurity\\SupportClient\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "StellarSecurity\\SupportClient\\SupportClientServiceProvider"
      ],
      "aliases": {
        "Support": "StellarSecurity\\SupportClient\\Facades\\Support"
      }
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}